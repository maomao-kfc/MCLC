        <result property="specialRequirements" column="special_requirements" jdbcType="VARCHAR"/>
        <result property="isFirst" column="is_first" jdbcType="INTEGER"/>
        <result property="gender" column="gender" jdbcType="VARCHAR"/>
        <result property="occupation" column="occupation" jdbcType="VARCHAR"/>
        <result property="experience" column="experience" jdbcType="VARCHAR"/>
        <result property="fieldOfInterest" column="field_of_interest" jdbcType="VARCHAR"/>
        <result property="other" column="other" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="selectRegisterUserPage" resultMap="RegisterUserPageVOMap">
        SELECT
            rui.id,
            rui.connect_id,
            rui.name,
            rui.surname,
            rui.email,
            rui.organization,
            rui.mobile_phone,
            rui.street,
            rui.postal_code,
            rui.status,
            rui.country,
            rui.bill_organization,
            rui.bill_vat,
            rui.bill_procurement,
            rui.bill_street,
            rui.bill_postal_code,
            rui.bill_city,
            rui.bill_status,
            rui.bill_country,
            rui.registration_type,
            rui.registration_fee,
            DATE_FORMAT(rui.registration_date, '%Y-%m-%d') AS registration_date,
            rui.payment_method,
            rui.payment_status,
            rui.stripe_payment_intent_id,
            rui.payment_amount,
            rui.visa_name,
            rui.visa_surname,
            rui.visa_passport,
            rui.visa_issue_time,
            rui.visa_end_time,
            rui.visa_time,
            rui.visa_area,
            rui.visa_is_need,
            rui.deduction_code,
            rui.pic_bank,
            rui.actual_payment,
            rui.register_label,
            rui.review_status,
            rui.reject_reason,
            qs.registration_category,
            qs.registration_document,
            qs.registration_which_member,
            qs.registration_code,
            qs.is_match_drug,
            qs.dietary_requirements,
            qs.special_requirements,
            qs.is_first,
            qs.gender,
            qs.occupation,
            qs.experience,
            qs.field_of_interest,
            qs.other
        FROM register_user_information rui
        LEFT JOIN questionnaire_survey qs ON rui.connect_id = qs.id
        WHERE 1=1
        <if test="query.name != null and query.name != ''">
            AND rui.name LIKE CONCAT('%', #{query.name}, '%')
        </if>
        <if test="query.surname != null and query.surname != ''">
            AND rui.surname LIKE CONCAT('%', #{query.surname}, '%')
        </if>
        <if test="query.email != null and query.email != ''">
            AND rui.email LIKE CONCAT('%', #{query.email}, '%')
        </if>
        <if test="query.organization != null and query.organization != ''">
            AND rui.organization LIKE CONCAT('%', #{query.organization}, '%')
        </if>
        <if test="query.mobilePhone != null and query.mobilePhone != ''">
            AND rui.mobile_phone LIKE CONCAT('%', #{query.mobilePhone}, '%')
        </if>
        <if test="query.status != null">
            AND rui.status = #{query.status}
        </if>
        <if test="query.country != null and query.country != ''">
            AND rui.country LIKE CONCAT('%', #{query.country}, '%')
        </if>
        <if test="query.registrationType != null and query.registrationType != ''">
            AND rui.registration_type = #{query.registrationType}
        </if>
        <if test="query.paymentMethod != null and query.paymentMethod != ''">
            AND rui.payment_method = #{query.paymentMethod}
        </if>
        <if test="query.paymentStatus != null and query.paymentStatus != ''">
            AND rui.payment_status = #{query.paymentStatus}
        </if>
        <if test="query.visaName != null and query.visaName != ''">
            AND rui.visa_name LIKE CONCAT('%', #{query.visaName}, '%')
        </if>
        <if test="query.visaPassport != null and query.visaPassport != ''">
            AND rui.visa_passport LIKE CONCAT('%', #{query.visaPassport}, '%')
        </if>
        <if test="query.visaIsNeed != null">
            AND rui.visa_is_need = #{query.visaIsNeed}
        </if>
        <if test="query.registrationCategory != null and query.registrationCategory != ''">
            AND qs.registration_category = #{query.registrationCategory}
        </if>
        <if test="query.deductionCode != null and query.deductionCode != ''">
            AND rui.deduction_code LIKE CONCAT('%', #{query.deductionCode}, '%')
        </if>
        ORDER BY rui.id DESC
    </select>

    <select id="selectRegisterUserDetail" resultMap="RegisterUserPageVOMap">
        SELECT
            rui.id,
            rui.connect_id,
            rui.name,
            rui.surname,
            rui.email,
            rui.organization,
            rui.mobile_phone,
            rui.street,
            rui.postal_code,
            rui.status,
            rui.country,
            rui.bill_organization,
            rui.bill_vat,
            rui.bill_procurement,
            rui.bill_street,
            rui.bill_postal_code,
            rui.bill_city,
            rui.bill_status,
            rui.bill_country,
            rui.registration_type,
            rui.registration_fee,
            DATE_FORMAT(rui.registration_date, '%Y-%m-%d') AS registration_date,
            rui.payment_method,
            rui.payment_status,
            rui.stripe_payment_intent_id,
            rui.payment_amount,
            rui.visa_name,
            rui.visa_surname,
            rui.visa_passport,
            rui.visa_issue_time,
            rui.visa_end_time,
            rui.visa_time,
            rui.visa_area,
            rui.visa_is_need,
            rui.deduction_code,
            rui.pic_bank,
            rui.actual_payment,
            rui.register_label,
            rui.review_status,
            rui.reject_reason,
            qs.registration_category,
            qs.registration_document,
            qs.registration_which_member,
            qs.registration_code,
            qs.is_match_drug,
            qs.dietary_requirements,
            qs.special_requirements,
            qs.is_first,
            qs.gender,
            qs.occupation,
            qs.experience,
            qs.field_of_interest,
            qs.other
        FROM register_user_information rui
        LEFT JOIN questionnaire_survey qs ON rui.connect_id = qs.id
        WHERE rui.id = #{id}
    </select>

</mapper>
