        <result property="paymentAmount" column="payment_amount" jdbcType="VARCHAR"/>
        <result property="visaName" column="visa_name" jdbcType="VARCHAR"/>
        <result property="visaSurname" column="visa_surname" jdbcType="VARCHAR"/>
        <result property="visaPassport" column="visa_passport" jdbcType="VARCHAR"/>
        <result property="visaIssueTime" column="visa_issue_time" jdbcType="VARCHAR"/>
        <result property="visaEndTime" column="visa_end_time" jdbcType="VARCHAR"/>
        <result property="visaTime" column="visa_time" jdbcType="VARCHAR"/>
