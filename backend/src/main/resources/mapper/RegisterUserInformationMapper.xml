        <result property="registrationCode" column="registration_code" jdbcType="VARCHAR"/>
        <result property="deductionCode" column="deduction_code" jdbcType="VARCHAR"/>
        <result property="picBank" column="pic_bank" jdbcType="VARCHAR"/>
        <result property="actualPayment" column="actual_payment" jdbcType="VARCHAR"/>
        <result property="registerLabel" column="register_label" jdbcType="VARCHAR"/>
        <result property="reviewStatus" column="review_status" jdbcType="INTEGER"/>
        <result property="rejectReason" column="reject_reason" jdbcType="VARCHAR"/>
        <result property="isMatchDrug" column="is_match_drug" jdbcType="INTEGER"/>
