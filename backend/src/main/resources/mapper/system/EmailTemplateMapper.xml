<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youlai.boot.system.mapper.EmailTemplateMapper">
    <!-- 邮箱模板分页列表 -->
    <select id="getEmailTemplatePage" resultType="com.youlai.boot.system.model.vo.EmailTemplatePageVO">
        SELECT
            t1.id,
            t1.email_title,
            t1.email_type,
            t1.email_content,
            t1.sort,
            t1.status,
            t1.remark,
            t1.create_time,
            t1.update_time
        FROM
            sys_email_template t1
        <where>
            t1.is_deleted = 0
            <if test='queryParams.keywords!=null and queryParams.keywords.trim() neq ""'>
                AND t1.email_title LIKE CONCAT('%',#{queryParams.keywords},'%')
            </if>
            <if test='queryParams.status!=null'>
                AND t1.status = #{queryParams.status}
            </if>
        </where>
        ORDER BY
            t1.sort ASC, t1.create_time DESC
    </select>
</mapper>
